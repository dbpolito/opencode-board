{
  "name": "opencode-board",
  "version": "0.2.0",
  "description": "A global Kanban task board for OpenCode Desktop",
  "license": "MIT",
  "author": "dbpolito",
  "homepage": "https://github.com/dbpolito/opencode-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbpolito/opencode-board.git"
  },
  "bugs": {
    "url": "https://github.com/dbpolito/opencode-board/issues"
  },
  "keywords": ["opencode", "opencode-plugin", "kanban", "tasks", "desktop"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./rpc": "./dist/rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && bun run build:server",
    "build:server": "bun build src/server.ts src/rpc.ts --target=node --external '@opencode/*' --outdir dist",
    "dev": "bun run build:server && vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && node --test tests/*.test.mjs",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/solid": "^0.5.1",
    "@opencode/plugin": "2.2.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "effect": "4.0.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
